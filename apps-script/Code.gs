function setupTeamDispatch(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('請從 Google Sheet 的「擴充功能 → Apps Script」建立此綁定指令碼。');PropertiesService.getScriptProperties().setProperty(APP.DB_PROPERTY,ss.getId());ensureSheet_(ss,APP.USERS,USER_HEADERS);ensureSheet_(ss,APP.TASKS,TASK_HEADERS);ensureSheet_(ss,APP.SESSIONS,SESSION_HEADERS);ensureSheet_(ss,APP.LEAVES,LEAVE_HEADERS);ensureSheet_(ss,APP.TRIPS,TRIP_HEADERS);const users=readObjects_(APP.USERS);if(!users.some(u=>String(u.username).toLowerCase()===APP.ADMIN_USERNAME)){const salt=randomToken_();appendObject_(APP.USERS,USER_HEADERS,{id:newId_('USR'),username:APP.ADMIN_USERNAME,displayName:'Administrator',passwordHash:hashPassword_(APP.ADMIN_INITIAL_PASSWORD,salt),salt,role:'admin',active:true,createdAt:nowIso_()})}const sessions=ss.getSheetByName(APP.SESSIONS);if(sessions&&!sessions.isSheetHidden())sessions.hideSheet();SpreadsheetApp.getUi().alert('初始化完成\n\n已確認 Users / Tasks / Sessions / Leaves / Trips 資料表。')}
